{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "fr",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://www.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
